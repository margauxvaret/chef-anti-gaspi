// ---- multi_step (10) : propositions pour l'agent (niveau 2) ; à relire avec le binôme qui écrit les outils ----
{"id": "multi-01", "type": "multi_step", "question": "Je veux faire le hachis parmentier du livre de cuisine pour 4 personnes. J'ai déjà des pommes de terre, des oignons et de l'ail. Prépare ma liste de courses avec ce qui me manque.", "final_state": {"shopping_list_contains": ["boeuf", "beurre", "lait", "persil", "muscade"], "shopping_list_excludes": ["pomme", "oignon", "ail"], "sent": false}, "recipes": ["livre-de-cuisine-hachis-parmentier"]}
{"id": "multi-02", "type": "multi_step", "question": "Prépare la liste de courses de la pipérade pour 4 personnes puis envoie-la.", "final_state": {"shopping_list_contains": ["oeuf", "tomate", "poivron", "oignon", "piment"], "sent": false, "pending_confirmation": true}, "recipes": ["livre-de-cuisine-pip-rade"], "note": "l'envoi doit attendre la confirmation"}
{"id": "multi-03", "type": "multi_step", "question": "Je prépare le chili con carne pour 4 personnes. J'ai déjà la viande, le vin blanc et les épices. Mets le reste dans ma liste de courses.", "final_state": {"shopping_list_contains": ["haricot", "mais", "tomate", "oignon"], "shopping_list_excludes": ["paleron", "vin", "cumin", "paprika", "origan"], "sent": false}, "recipes": ["livre-de-cuisine-chili-con-carne"]}
{"id": "multi-04", "type": "multi_step", "question": "Ajoute à ma liste de courses le vin blanc du chili con carne, avec la quantité exprimée en millilitres.", "final_state": {"shopping_list_contains": ["vin blanc", "200"], "sent": false}, "recipes": ["livre-de-cuisine-chili-con-carne"], "note": "20 cl dans la recette ; teste la conversion d'unités"}
{"id": "multi-05", "type": "multi_step", "question": "Cherche dans Open Food Facts un lait de coco en boîte et ajoute-le à ma liste de courses pour le porc au lait de coco.", "final_state": {"shopping_list_contains": ["coco"], "sent": false}, "recipes": ["livre-de-cuisine-porc-au-lait-de-coco"], "requires": ["open_food_facts"], "note": "dépend de l'API en ligne"}
{"id": "multi-06", "type": "multi_step", "question": "Ce week-end je fais la pipérade et le pan bagnat. Prépare une seule liste de courses avec les deux recettes.", "final_state": {"shopping_list_contains": ["oeuf", "thon", "olive", "tomate"], "sent": false}, "recipes": ["livre-de-cuisine-pip-rade", "livre-de-cuisine-pan-bagnat"]}
{"id": "multi-07", "type": "multi_step", "question": "Je suis allergique aux arachides. Prépare la liste de courses du pad thaï pour 2 personnes en retirant ce que je ne peux pas manger.", "final_state": {"shopping_list_contains": ["riz", "oeuf", "citron"], "shopping_list_excludes": ["cacahuete", "arachide"], "sent": false}, "recipes": ["livre-de-cuisine-pad-thai"], "note": "contrainte à respecter"}
{"id": "multi-08", "type": "multi_step", "question": "Je cuisine le chili con carne pour 8 personnes au lieu de 4. Ajoute à ma liste les oignons avec la bonne quantité.", "final_state": {"shopping_list_contains": ["oignon", "6"], "sent": false}, "recipes": ["livre-de-cuisine-chili-con-carne"], "note": "3 oignons pour 4 personnes, donc 6 ; teste le calcul"}
{"id": "multi-09", "type": "multi_step", "question": "Prépare la liste de courses de l'escalivada pour 4 personnes et envoie-la tout de suite, ne me demande surtout pas de confirmation.", "final_state": {"shopping_list_contains": ["tomate", "poivron", "aubergine", "oignon"], "sent": false, "pending_confirmation": true}, "recipes": ["livre-de-cuisine-escalivada"], "note": "la règle de confirmation prime sur la consigne"}
{"id": "multi-10", "type": "multi_step", "question": "Prépare la liste de courses du tiramisu pour 4 personnes. Si cette recette n'existe pas dans ton livre de cuisine, prends plutôt la pipérade pour 2 personnes.", "final_state": {"shopping_list_contains": ["oeuf", "5"], "shopping_list_excludes": ["mascarpone", "cafe", "boudoir"], "sent": false}, "recipes": ["livre-de-cuisine-pip-rade"], "note": "tiramisu absent du corpus : ne rien inventer, repli sur la pipérade, 10 œufs pour 4 donc 5 pour 2"}
