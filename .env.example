# Copiez ce fichier en .env (jamais commité) et adaptez.

# --- Développement : Ollama en local ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:3b

# --- Niveau 1 (RAG) : embeddings via Ollama (`ollama pull bge-m3`) ---
# EMBED_MODEL=bge-m3
# RAG_MODE=hybrid          # hybrid | dense | bm25 (pour comparer les variantes dans le rapport)
# RAG_TOP_K=4              # extraits donnés au LLM
# RAG_CHUNK_CHARS=800      # taille des extraits

# --- API partagée du prof (si compatible OpenAI) : seulement pour les évaluations finales ---
# LLM_BASE_URL=https://URL_DONNEE_PAR_LE_PROF/v1
# LLM_API_KEY=VOTRE_CLE
# LLM_MODEL=NOM_DU_MODELE

